// =============================================
// EXPERIENCE AI — prisma/schema.prisma
// ORM Prisma sur PostgreSQL.
//
// Trois tables : users (comptes), parcours (l'agrégat du doc 06, ADR-0007) et
// preferences_parcours (la mémoire simple du sprint R5).
//
// Les tables du modèle Pack hérité de TripGenie (trips, packs, trip_votes,
// trip_collaborators, user_preferences) ont été supprimées au sprint R6b :
// le Parcours est désormais le seul modèle de domaine.
//
// Choix conservés :
// - champs en snake_case → colonne SQL = champ Prisma = clé JSON d'API
// - @db.Uuid partout, onDelete: Cascade sur les tables rattachées à un compte
// - @updatedAt → remplace les "updated_at = NOW()" manuels
// - le contenu métier vit dans une colonne JSON validée par Zod dans le dépôt
// =============================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---- USERS ----
model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  password   String
  name       String?
  avatar_url String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  parcours             Parcours[]
  preferences_parcours PreferenceParcours?

  @@map("users")
}

// ---- PRÉFÉRENCES DE PARCOURS (mémoire simple, sprint R5) ----
// Même principe que la table parcours (ADR-0007) : contenu JSON validé par
// Zod aux frontières (server/depots/depotPreferences.ts, seule porte d'accès).
model PreferenceParcours {
  user_id    String   @id @db.Uuid
  contenu    Json
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("preferences_parcours")
}

// ---- PARCOURS (ADR-0007) ----
// L'agrégat complet vit dans `contenu` (validé par ParcoursSchema à chaque
// lecture, dans server/depots/depotParcours.ts — seule porte d'accès).
// Les autres colonnes sont des projections dérivées à l'écriture.
model Parcours {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  intention  String
  visibilite String   @default("prive")
  contenu    Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("parcours")
}
