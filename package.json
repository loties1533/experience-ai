{
  "name": "experience-ai",
  "version": "1.0.0",
  "type": "module",
  "description": "Experience AI — cadrage d'une envie, génération et modification ciblée d'un parcours",
  "main": "dist-server/index.js",
  "scripts": {
    "start": "node dist-server/index.js",
    "dev": "nodemon --exec tsx server/index.ts",
    "dev:all": "concurrently -n server,client -c cyan,magenta \"npm run dev\" \"npm run client:dev\"",
    "lint": "eslint server client-react/src",
    "build:server": "prisma generate && npx tsc",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "client:dev": "cd client-react && npm run dev",
    "build": "cd client-react && npm install --include=dev && npm run build",
    "client:build": "cd client-react && npm run build",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:services": "vitest run tests/services/",
    "test:security": "vitest run tests/security/",
    "test:middleware": "vitest run tests/middleware.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.8.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.0.2",
    "nodemon": "^3.0.2",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
