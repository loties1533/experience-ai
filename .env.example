# =============================================
# EXPERIENCE AI — Variables d'environnement (modèle)
# Copie ce fichier en .env puis remplis les valeurs.
# Ne JAMAIS committer le .env réel sur GitHub !
# Ce fichier liste UNIQUEMENT les variables réellement lues par le code.
# =============================================

# ---- Serveur ----
PORT=3000
NODE_ENV=development

# ---- Authentification (JWT signé par NOTRE serveur) ----
# Génère un secret fort :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_with_a_long_random_string

# ---- Base de données : PostgreSQL via l'ORM Prisma ----
# Isolation des données : filtrage applicatif `where: { user_id }` dans chaque
# route protégée (l'id de l'utilisateur vient du JWT signé).
# En local : PostgreSQL dans Docker (`docker compose up db`).
# Port 5434 volontairement : la base d'Experience AI est SÉPARÉE de celle de
# TripGenie (5433). Aucune base n'est jamais partagée entre les deux projets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/experience_ai?schema=public

# ---- Fournisseur IA principal : anthropic | gemini | ollama | openrouter ----
AI_PROVIDER=anthropic

# ---- LLM : cascade de secours (Gemini -> OpenRouter -> Claude -> mocks) ----
GEMINI_API_KEY=your_gemini_api_key          # LLM principal
OPENROUTER_API_KEY=your_openrouter_key      # secours multi-modèles
ANTHROPIC_API_KEY=sk-ant-xxxx               # secours Claude

# ---- Ollama (LLM local optionnel, utilisé si AI_PROVIDER=ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# ---- Recherche Web de candidats de liens (Tavily, sans validation officielle automatique) ----
TAVILY_API_KEY=tvly-xxxx

# ---- Restaurants (Foursquare en premier, Yelp en secours) ----
FOURSQUARE_API_KEY=your_foursquare_api_key
YELP_API_KEY=your_yelp_api_key

# ---- Événements réels : concerts, festivals (predicthq.com) ----
PREDICTHQ_API_KEY=your_predicthq_api_key

# ---- Lieux et candidats de vols (Amadeus Self-Service, environnement de test) ----
# Utilisées uniquement côté serveur pour rechercher des villes, aéroports et
# candidats de vols internes. Aucun prix, disponibilité durable ou réservation
# n'est exposé par Experience AI à ce stade.
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret

# ---- Photos de destination (Unsplash en premier, Pexels en secours) ----
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
PEXELS_API_KEY=your_pexels_api_key

# ---- CORS : origine du frontend autorisée ----
CLIENT_URL=http://localhost:3001
